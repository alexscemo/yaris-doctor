<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:colorAccent">@color/primary</item>
        <item name="android:colorBackground">@color/canvas</item>
        <item name="android:windowBackground">@color/canvas</item>
        <item name="android:statusBarColor">@color/canvas</item>
        <item name="android:navigationBarColor">@color/canvas</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:alertDialogTheme">@style/AppDialog</item>
    </style>

    <style name="AppDialog" parent="@android:style/Theme.DeviceDefault.Dialog.Alert">
        <item name="android:colorAccent">@color/primary</item>
        <item name="android:colorBackground">@color/canvas</item>
        <item name="android:windowBackground">@drawable/dialog_bg</item>
        <item name="android:textColorPrimary">@color/ink</item>
    </style>
    <!-- The picked day is black on the orange (textColorPrimaryInverse); the header keeps its light text on the dark instrument colour -->
    <style name="AppDatePicker" parent="@android:style/Theme.DeviceDefault.Dialog">
        <item name="android:colorAccent">@color/primary</item>
        <item name="android:colorBackground">@color/canvas</item>
        <item name="android:windowBackground">@drawable/dialog_bg</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorPrimaryInverse">@color/on_primary</item>
        <item name="android:datePickerStyle">@style/AppDatePickerStyle</item>
    </style>

    <style name="AppDatePickerStyle" parent="@android:style/Widget.Material.DatePicker">
        <item name="android:headerBackground">@color/instrument</item>
    </style>
</resources>
