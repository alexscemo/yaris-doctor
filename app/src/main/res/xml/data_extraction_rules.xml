<?xml version="1.0" encoding="utf-8"?>
<!--
  The log is deliberately left out of cloud backups. Android's Auto Backup quota is 25 MB, the frame table passes it
  within weeks, and a backup over quota fails silently (the whole backup, not just the database). Settings -> Your data
  -> "Back up database" writes a restorable snapshot to Downloads instead.

  Device-to-device transfer has room, so the whole log travels with it. The includes below are explicit because an
  <include> switches that section to "only these files"; they are the same four domains Auto Backup covers by default.

  Shared preferences are small and harmless in both. A restore resets the sync cursors itself, so the hub re-uploads
  the whole log and ignores what it already has.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <include domain="file" path="." />
        <include domain="external" path="." />
        <include domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
